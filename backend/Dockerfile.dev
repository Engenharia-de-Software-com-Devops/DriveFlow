FROM golang:1.24-alpine

ARG UID=1000
ARG GID=1000

WORKDIR /app

RUN apk add --no-cache wget \
    && go install github.com/air-verse/air@v1.61.7

# Baixa os modulos antes do codigo para aproveitar o cache de camadas.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV API_PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

# O processo usa o mesmo UID/GID do host para preservar a posse dos bind mounts.
RUN mkdir -p /tmp/go-build && \
    chown -R ${UID}:${GID} /app /go /tmp/go-build

ENV GOCACHE=/tmp/go-build

USER ${UID}:${GID}

# Air recompila e reinicia a API quando os arquivos Go montados pelo host mudam.
CMD ["air", "--build.cmd", "go build -o /tmp/air/api ./cmd/app", "--build.bin", "/tmp/air/api"]
