# Debian usa glibc, compatível com os modulos nativos instalados no host Linux.
FROM node:22-bookworm-slim

ARG UID=1000
ARG GID=1000

WORKDIR /app

# npm ci respeita o lockfile; o bind mount compartilha node_modules com o host.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# npm precisa de um diretorio gravavel mesmo quando executado por UID/GID numericos.
ENV HOST=0.0.0.0 \
    HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/.npm
EXPOSE 3000

USER ${UID}:${GID}

# O bind mount inicia vazio; instale as dependencias nele antes de subir o Vite.
CMD ["sh", "-c", "npm ci && npm run dev -- --host 0.0.0.0 --port 3000"]
