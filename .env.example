# Copie para .env antes de rodar o docker compose:
#   cp .env.example .env
#
# O arquivo .env e ignorado pelo git. Nao versione credenciais reais.

# ---- Banco (container db) ----
POSTGRES_USER=driveflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=driveflow
POSTGRES_PORT=5432

# ---- API (container api) ----
API_PORT=8080

# ---- Frontend (container web) ----
WEB_PORT=3000

# ---- Execucao fora do compose ----
# Sem DATABASE_URL a api sobe com armazenamento em memoria.
# Para apontar para o postgres do compose a partir da maquina local:
# DATABASE_URL=postgres://driveflow:troque-esta-senha@localhost:5432/driveflow?sslmode=disable
